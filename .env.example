# Copy to .env — or better, run ./scripts/init-env.sh which generates random secrets for you.
# Never commit .env.  Values below are placeholders only.

POSTGRES_USER=warehouse
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>   # hex/alphanumeric only (it is embedded in DATABASE_URL)
POSTGRES_DB=warehouse

# >= 32 characters
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_EXPIRES_IN_SECONDS=28800
BCRYPT_ROUNDS=10

# Demo users created by the migrate job if they do not exist yet (>= 8 characters).
SEED_OPERATOR_PASSWORD=<choose>
SEED_SUPERVISOR_PASSWORD=<choose>

# Host port for the web UI
WEB_PORT=8080
